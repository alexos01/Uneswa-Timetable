{
  "name": "uneswa-timetable",
  "version": "1.0.0",
  "private": true,
  "description": "Personal class and exam timetable for UNESWA students: web (GitHub Pages) and Android/iOS (Capacitor).",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build-www.mjs",
    "vendor": "node scripts/vendor.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:ui": "node --test --test-concurrency=1 \"tests/ui/*.test.mjs\"",
    "test:db": "bash tests/db/run.sh"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.117.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  }
}
